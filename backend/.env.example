APP_NAME=Lead Gen API
APP_VERSION=1.0.0
APP_ENV=development
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO

# Firebase Admin (server-side only)
FIREBASE_PROJECT_ID=
# Local development: absolute path to a downloaded service-account JSON file.
# Example on Windows: D:/Secrets/lead-gen-firebase-admin.json
FIREBASE_CREDENTIALS_PATH=
# Alternative for hosted environments such as Render. Paste the service-account JSON as one environment variable.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Turso Cloud (server-side only)
# Example: turso://your-db-your-org.turso.io
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
TURSO_TIMEOUT_SECONDS=15

# Encrypts user BYOK provider credentials stored in Turso. Generate once and keep stable.
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIAL_ENCRYPTION_KEY=

FRONTEND_APP_URL=http://localhost:5173
# Public HTTPS API base URL after deployment; required for real-time Hostinger reply webhooks.
PUBLIC_API_URL=
GMAIL_OAUTH_CLIENT_ID=
GMAIL_OAUTH_CLIENT_SECRET=
GMAIL_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/outreach/gmail/callback

# Admin / production operations
ADMIN_EMAILS=
BACKGROUND_JOBS_MODE=inline
WORKER_POLL_SECONDS=3
WORKER_LEASE_SECONDS=300
USER_ACCESS_CACHE_SECONDS=60

# Zero-cost Render mode: run both durable workers inside the API process.
EMBEDDED_WORKERS=false
# Protects Quick Send from accidental rapid-fire use.
QUICK_SEND_PER_MINUTE=6
