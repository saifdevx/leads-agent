APP_NAME=Lead Platform API
APP_VERSION=0.5.0
APP_ENV=development
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO

# Firebase Admin (server-side only)
FIREBASE_PROJECT_ID=
# Local development: absolute path to a downloaded service-account JSON file.
# Example on Windows: D:/Secrets/lead-platform-firebase-admin.json
FIREBASE_CREDENTIALS_PATH=
# Alternative for hosted environments such as Render. Paste the service-account JSON as one environment variable.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Turso Cloud (server-side only)
# Example: turso://your-db-your-org.turso.io
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
TURSO_TIMEOUT_SECONDS=15

# Encrypts user BYOK provider credentials stored in Turso. Generate once and keep stable.
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIAL_ENCRYPTION_KEY=
